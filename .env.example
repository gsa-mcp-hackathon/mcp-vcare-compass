# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (IBM Code Engine, Databricks Apps) you usually leave this as
# stdio: app.py automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── Genie agent (ask_vcare_case_data) ───────────────────────────────────────
# Space ID of the "Healthcare Risk and Coordination Analysis" Genie agent.
# On Databricks Apps this is injected from the `genie-space` app resource.
# Locally, the Databricks SDK also needs credentials (e.g. DATABRICKS_HOST plus
# a `databricks auth login` profile). Matching fields: src/mcp_vcare_compass/config.py.
# Never commit the filled-in .env.
GENIE_SPACE_ID=
GENIE_TIMEOUT_SECONDS=120
GENIE_PREVIEW_ROWS=20
